# Template only. Copy to an untracked local environment file.
# Never put real credentials, provider tokens, or investigation data here.

APP_ENV=development
# The existing backend serves the frontend and API from one origin.
APP_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# PostgreSQL local development connection; change the password if you override Compose.
DATABASE_URL=postgresql://tracelynt_app:local-dev-only-change-me@127.0.0.1:5432/tracelynt
DB_POOL_MAX=10

# Generic OpenID Connect provider configuration. Register this exact callback URL:
# http://127.0.0.1:8000/auth/callback
# Do not configure production sign-in until provider and data-processing terms are reviewed.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Generate a unique secret with: openssl rand -base64 32
# Keep it in an untracked local env file or a deployment secret manager.
AUTH_SECRET=

PHONE_METADATA_PROVIDER=
PHONE_METADATA_API_KEY=
DOMAIN_INTELLIGENCE_PROVIDER=
DOMAIN_INTELLIGENCE_API_KEY=

# Keep verbose payload logging disabled for sensitive searches.
LOG_LEVEL=info
LOG_REDACT_PERSONAL_DATA=true
