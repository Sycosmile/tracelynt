# Template only. Copy to an untracked local environment file.
# Never put real credentials, provider tokens, or investigation data here.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Configure only after selecting the implementation stack.
DATABASE_URL=

# Use a secret manager or local untracked file for real values.
AUTH_SECRET=
PHONE_METADATA_PROVIDER=
PHONE_METADATA_API_KEY=
DOMAIN_INTELLIGENCE_PROVIDER=
DOMAIN_INTELLIGENCE_API_KEY=

# Keep verbose payload logging disabled for sensitive searches.
LOG_LEVEL=info
LOG_REDACT_PERSONAL_DATA=true